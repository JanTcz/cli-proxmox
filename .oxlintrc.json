{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "unicorn",
    "import",
    "node",
    "promise",
    "oxc"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "error"
  },
  "rules": {
    "no-console": "off",
    "import/no-cycle": "error",
    "typescript/no-explicit-any": "off",
    "typescript/no-non-null-assertion": "off"
  },
  "ignorePatterns": [
    "node_modules",
    "src/api/pve.gen.ts"
  ]
}
