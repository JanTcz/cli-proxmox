{
  "name": "cli-proxmox",
  "version": "0.1.0",
  "description": "A command line for Proxmox VE and its MCP twin: one catalog, scoped and audited, on Proxmox's own API schema.",
  "type": "module",
  "license": "MIT",
  "author": "Jan Truhlar <me@jant.cz>",
  "homepage": "https://github.com/JanTcz/cli-proxmox#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JanTcz/cli-proxmox.git"
  },
  "bugs": "https://github.com/JanTcz/cli-proxmox/issues",
  "keywords": [
    "proxmox",
    "pve",
    "mcp",
    "cli",
    "homelab"
  ],
  "bin": {
    "cli-proxmox": "dist/bin/proxmox.js",
    "proxmox": "dist/bin/proxmox.js"
  },
  "files": [
    "dist",
    "agents"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "typecheck": "tsc",
    "test": "node --test --test-timeout=20000 --experimental-test-coverage --test-coverage-include='src/**' --test-coverage-exclude='src/main.ts' --test-coverage-exclude='src/api/pve.gen.ts' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 'test/*.test.ts'",
    "check": "npm run lint && npm run typecheck && npm test",
    "generate": "node scripts/generate.ts",
    "hooks": "git config core.hooksPath hooks",
    "contract": "node scripts/contract.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "oxlint": "^1.86.0",
    "typescript": "^7.0.2"
  }
}
